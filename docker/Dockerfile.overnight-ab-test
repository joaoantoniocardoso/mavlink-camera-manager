FROM rust:1-bookworm AS builder

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    libclang-dev \
    pkg-config \
    libssl-dev \
    libglib2.0-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    libgstrtspserver-1.0-dev \
    libv4l-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

ENV SKIP_WEB=1
RUN mkdir -p frontend/dist && cargo build --release --example stream_latency

FROM debian:bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    bc \
    ca-certificates \
    coreutils \
    curl \
    iproute2 \
    iputils-ping \
    jq \
    openssh-client \
    procps \
    python3 \
    python3-matplotlib \
    python3-numpy \
    python3-pandas \
    python3-scipy \
    sshpass \
    sudo \
    texlive-fonts-recommended \
    texlive-latex-base \
    texlive-latex-extra \
    lmodern \
    libglib2.0-0 \
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    libgstreamer-plugins-bad1.0-0 \
    libgstrtspserver-1.0-0 \
    gstreamer1.0-libav \
    gstreamer1.0-nice \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/mcm

COPY --from=builder /src/target/release/examples/stream_latency /usr/local/bin/stream_latency
COPY scripts /opt/mcm/scripts
COPY examples/README.md /opt/mcm/examples/README.md
COPY docker/entrypoint-overnight-ab-test.sh /usr/local/bin/mcm-overnight-ab-test

RUN chmod +x \
    /usr/local/bin/stream_latency \
    /usr/local/bin/mcm-overnight-ab-test \
    /opt/mcm/scripts/overnight_ab_test.sh \
    /opt/mcm/scripts/switch_blueos_image.sh \
    /opt/mcm/scripts/usb-eth-reset.sh

ENV STREAM_LATENCY_BIN=/usr/local/bin/stream_latency
ENV OUTPUT_DIR=/results

VOLUME ["/results"]

ENTRYPOINT ["/usr/local/bin/mcm-overnight-ab-test"]
